---
import Section from "./Section.astro";
import { nav, navigationItems, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const greeting = { de: "Hallo, ich bin", en: "Hi, I'm" };
const sections = navigationItems.filter((item) => item !== "home");
---

<Section id="home">
  <h1>{greeting[lang]} <span class="gradient-text">Ergün</span></h1>
</Section>

{
  sections.map((item) => (
    <Section id={item}>
      <h2 class="gradient-text">{nav[lang][item]}</h2>
    </Section>
  ))
}

<style>
  h1,
  h2 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.25;
  }
</style>
