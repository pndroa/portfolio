---
import profilePicture from "@/assets/icon.jpeg";
import CardNav from "@/components/ui/CardNav";
import { site } from "@/data/site";
import { nav, navigationItems, type Lang, type NavItem } from "@/i18n/ui";
import { Download, Languages } from "@lucide/astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  lang: Lang;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;

const labels = {
  de: {
    navAria: "Hauptnavigation",
    home: "Ergün Bickici, zur Startseite",
    menu: "Menü öffnen",
    close: "Menü schließen",
    cv: "Lebenslauf",
    cvAria: "Lebenslauf als PDF herunterladen",
    cvTitle: "Lebenslauf",
    cvDescription: "Alle Stationen kompakt als PDF",
    cvDownload: "Herunterladen",
    switchTo: "EN",
    switchAria: "Switch to English",
    overview: "Überblick",
    overviewDescription: "Wer ich bin und was ich mache",
    experience: "Erfahrung",
    experienceDescription: "Was ich kann und wo ich es gelernt habe",
    connect: "Vernetzen",
    connectDescription: "Schreib mir gerne",
    email: "E-Mail",
  },
  en: {
    navAria: "Main navigation",
    home: "Ergün Bickici, go to homepage",
    menu: "Open menu",
    close: "Close menu",
    cv: "Download CV",
    cvAria: "Download CV as PDF",
    cvTitle: "CV",
    cvDescription: "Everything at a glance as a PDF",
    cvDownload: "Download",
    switchTo: "DE",
    switchAria: "Auf Deutsch wechseln",
    overview: "Overview",
    overviewDescription: "Who I am and what I do",
    experience: "Experience",
    experienceDescription: "What I can do and where I learned it",
    connect: "Connect",
    connectDescription: "Feel free to reach out",
    email: "Email",
  },
};

const t = labels[lang];
const otherLang = lang === "de" ? "en" : "de";
const otherLangHref = alternateHref ?? getRelativeLocaleUrl(otherLang);
const homeHref = getRelativeLocaleUrl(lang);
const cvHref = "/cv.pdf";

const section = (id: NavItem) => ({
  label: nav[lang][id],
  href: `${homeHref}#${id}`,
});

const links = navigationItems.map(section);

const items = [
  {
    label: t.overview,
    description: t.overviewDescription,
    links: [section("home"), section("about")],
  },
  {
    label: t.experience,
    description: t.experienceDescription,
    links: [section("skills"), section("experience")],
  },
  {
    label: t.connect,
    description: t.connectDescription,
    links: [
      section("contact"),
      { label: t.email, href: `mailto:${site.email}` },
      { label: "GitHub", href: site.github, external: true },
      { label: "LinkedIn", href: site.linkedin, external: true },
    ],
  },
  {
    label: t.cvTitle,
    description: t.cvDescription,
    mobileOnly: true,
    links: [
      {
        label: t.cvDownload,
        href: cvHref,
        ariaLabel: t.cvAria,
        download: true,
      },
    ],
  },
];
---

<header class="site-header">
  <CardNav
    client:load
    brand={t.home}
    brandHref={`${homeHref}#home`}
    links={links}
    items={items}
    menuText={t.menu}
    closeText={t.close}
    ariaLabel={t.navAria}
  >
    <span slot="logo" class="brand">
      <span class="avatar">
        <Image
          src={profilePicture}
          alt=""
          width={80}
          height={80}
          loading="eager"
          class="avatar-image"
        />
      </span>
      <span class="brand-name">{site.name}</span>
    </span>

    <div slot="actions" class="header-actions">
      <a class="pill cv" href={cvHref} download aria-label={t.cvAria}>
        <Download size={16} aria-hidden="true" />
        <span>{t.cv}</span>
      </a>

      <a
        class="pill lang"
        href={otherLangHref}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t.switchAria}
      >
        <Languages size={16} aria-hidden="true" />
        <span>{t.switchTo}</span>
      </a>
    </div>
  </CardNav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 1.5rem;
    left: 0;
    right: 0;
    z-index: 10;
    width: var(--content-width);
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
  }

  .avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding-inline: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .pill:hover,
  .pill:focus-visible {
    background-color: rgb(255 255 255 / 0.1);
  }

  @container card-nav (max-width: 56rem) {
    .brand-name,
    .cv {
      display: none;
    }
  }
</style>
