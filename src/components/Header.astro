---
import { site } from "@/data/site";
import { nav, navigationItems, type Lang } from "@/i18n/ui";
import { ChevronDown, Download, Languages } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  lang: Lang;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;

const labels = {
  de: {
    navAria: "Hauptnavigation",
    menu: "Menü",
    cv: "Lebenslauf",
    cvAria: "Lebenslauf als PDF herunterladen",
    switchTo: "EN",
    switchAria: "Switch to English",
  },
  en: {
    navAria: "Main navigation",
    menu: "Menu",
    cv: "Download CV",
    cvAria: "Download CV as PDF",
    switchTo: "DE",
    switchAria: "Auf Deutsch wechseln",
  },
};

const t = labels[lang];
const otherLang = lang === "de" ? "en" : "de";
const otherLangHref = alternateHref ?? getRelativeLocaleUrl(otherLang);
const homeHref = getRelativeLocaleUrl(lang);
---

<header>
  <div class="header-box">
    <a class="header-left" href={`${homeHref}#home`}>
      <span class="name">{site.name}</span>
    </a>

    <div class="header-right">
      <nav class="menu" id="site-menu" aria-label={t.navAria}>
        <ul>
          {navigationItems.map((item) => (
            <li>
              <a href={`${homeHref}#${item}`}>{nav[lang][item]}</a>
            </li>
          ))}
        </ul>
      </nav>

      <button
        type="button"
        class="menu-toggle"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <ChevronDown size={20} aria-hidden="true" />
      </button>

      <a class="cv" href="/cv.pdf" download aria-label={t.cvAria}>
        <Download size={16} aria-hidden="true" />
        <span class="label">{t.cv}</span>
      </a>

      <a
        class="lang"
        href={otherLangHref}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t.switchAria}
      >
        <Languages size={16} aria-hidden="true" />
        <span>{t.switchTo}</span>
      </a>
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 1.5rem;
    left: 0;
    right: 0;
    z-index: 10;
    width: var(--content-width);
    height: 3.5rem;
    margin-inline: auto;
    background-color: rgb(8 13 27 / 0.05);
    backdrop-filter: blur(4px) saturate(1.5);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.3);
  }

  .header-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding-inline: 1.5rem;
  }

  .header-left,
  .header-right,
  .menu ul {
    display: flex;
    align-items: center;
  }

  .header-right {
    gap: 1.5rem;
  }

  .menu ul {
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .menu a {
    color: rgb(255 255 255 / 0.75);
    font-weight: 600;
  }

  .menu a:hover,
  .menu a:focus-visible {
    color: white;
  }

  .name {
    font-weight: 700;
  }

  .cv,
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .cv:hover,
  .lang:hover {
    background-color: rgb(255 255 255 / 0.1);
  }

  .menu-toggle {
    display: none;
    padding: 0.4rem;
    color: inherit;
    background: none;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    cursor: pointer;
  }

  .menu-toggle :global(svg) {
    transition: transform 0.2s;
  }

  .menu-toggle[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }

  @media (max-width: 60rem) {
    .header-right {
      gap: 0.5rem;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .menu {
      display: none;
    }

    .menu[data-open] {
      display: block;
      position: absolute;
      top: calc(100% + 0.75rem);
      right: 0;
      width: min(18rem, 100%);
      padding: 0.5rem;
      background-color: rgb(10 14 26 / 0.95);
      border: 1px solid rgb(255 255 255 / 0.1);
      border-radius: 1.25rem;
    }

    .menu[data-open] ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .menu[data-open] a {
      display: block;
      padding: 0.6rem 0.75rem;
    }
  }

  @media (max-width: 40rem) {
    .header-box {
      padding-inline: 1rem;
    }

    .cv .label,
    .lang :global(svg) {
      display: none;
    }

    .cv {
      padding: 0.45rem;
    }
  }
</style>

<script>
  const header = document.querySelector("header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = header?.querySelector<HTMLElement>(".menu");

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!menu.hasAttribute("data-open"));
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia("(max-width: 60rem)").addEventListener("change", () => {
      setOpen(false);
    });
  }
</script>
