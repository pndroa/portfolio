---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="legal">
  <h1 class="gradient-text">{title}</h1>
  <slot />
</article>

<style>
  .legal {
    width: var(--content-width);
    max-width: 48rem;
    margin-inline: auto;
    padding-block: 7rem 4rem;
  }

  h1 {
    margin-bottom: 2rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .legal :global(p),
  .legal :global(li),
  .legal :global(address) {
    color: rgb(255 255 255 / 0.75);
    line-height: 1.7;
  }

  .legal :global(p + p),
  .legal :global(address + p) {
    margin-top: 0.75rem;
  }

  .legal :global(address) {
    font-style: normal;
  }

  .legal :global(ul) {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal :global(a) {
    color: var(--accent-from);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
