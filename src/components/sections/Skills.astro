---
import Section from "@/components/Section.astro";
import SpotlightCard from "@/components/ui/SpotlightCard";
import { nav, type Lang } from "@/i18n/ui";
import {
  Code,
  Container,
  Database,
  FileSearch,
  Kanban,
  ListOrdered,
  Plug,
  Repeat,
  Sheet,
  Workflow,
} from "@lucide/astro";
import * as simpleIcons from "simple-icons";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type BrandIcon = { hex: string; path: string };

type Skill = {
  name: string | Record<Lang, string>;
  slug?: string;
  icon?: typeof Code;
  logo?: BrandIcon;
};

