const monthFormat = new Intl.DateTimeFormat(lang, {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatMonth = (value: string) =>
  monthFormat.format(new Date(`${value}-01`));

const data = experience.map(({ start, end, role, company, bullets, tags }) => ({
  period: `${formatMonth(start)} – ${end ? formatMonth(end) : present[lang]}`,
  role: role[lang],
  company,
  bullets: bullets.map((bullet) => bullet[lang]),
  tags,
}));
---

<Section id="experience">
  <div class="experience-container">
    <h2 class="experience-title gradient-text">{nav[lang].experience}</h2>
    <Timeline client:visible data={data} />
  </div>
</Section>

<style>
  .experience-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: var(--content-width);
    margin-inline: auto;
    padding-block: 6rem;
  }

  .experience-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }
</style>
