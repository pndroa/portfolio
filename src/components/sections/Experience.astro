      "FastAPI",
      "Pydantic",
      "Docling",
      "ChromaDB",
      "Docker",
      "REST API",
      "Git",
      "GitHub",
      "CI/CD",
    ],
  },
  {
    start: "2025-02",
    end: "2026-08",
    role: {
      de: "Werkstudent – KI-Integration & Prozessoptimierung",
      en: "Working Student – AI Integration & Process Optimization",
    },
    company: "Mercedes-Benz Group AG",
    bullets: [
      {
        de: "Ansprechpartner für den Einsatz von KI-Agenten in der Abteilung",
        en: "Point of contact for the use of AI agents in the department",
      },
      {
