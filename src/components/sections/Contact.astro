---
import ContactForm from "@/components/ContactForm.astro";
import Section from "@/components/Section.astro";
import { nav, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section id="contact">
  <div class="contact-container">
    <h2 class="contact-title gradient-text">{nav[lang].contact}</h2>
    <ContactForm lang={lang} />
  </div>
</Section>

<style>
  .contact-container {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    width: var(--content-width);
    margin-inline: auto;
    padding-block: 6rem;
  }

  .contact-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }
</style>
