{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chat-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "api.erguen-bickici.de", "custom_domain": true }],
	"ai": {
		"binding": "AI",
	},
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "portfolio-knowledge", "remote": true }],
	"ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	"vars": {
		"ALLOWED_ORIGINS": "https://erguen-bickici.de,https://dev.erguen-bickici.de,http://localhost:4321",
		"ANTHROPIC_MODEL": "claude-haiku-5-5",
	},
}
